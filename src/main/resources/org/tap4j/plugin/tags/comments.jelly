<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core"
>

	<j:if 
		test="${attrs.diagnostic != null and attrs.diagnostic.size() > 0 }">

		<j:set var="diagnostic" value="${attrs.diagnostic}" />
		<tr>
            <td></td>
            <td colspan='3'>
            <j:forEach items="${diagnostic}" var="entry">
                # ${entry.text}<br/>
            </j:forEach>
            </td>
        </tr>
	</j:if>

</j:jelly>
